# JWT Secret for encrypting tokens
JWT_SECRET=your_jwt_secret_here

# Neon PostgreSQL Cluster Connection URL
# Set this to connect to serverless Neon PG. If left empty, SQLite is used automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini API Key for Verification
# If left empty, the pipeline will fallback to OpenRouter, then to offline verification simulation.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Fallback when all Gemini keys are exhausted)
# Get your key at https://openrouter.ai/keys
# If left empty, the pipeline will fallback to offline verification simulation.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# YOLO Configuration
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.4
YOLO_INFERENCE_INTERVAL=0.15
